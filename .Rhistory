for (i in 1:num_lotes) {
# Definir el rango del lote
inicio <- (i - 1) * tamano_lote + 1
fin <- min(i * tamano_lote, total_respuestas)
cat("----------------------------------------------------------\n")
cat("Procesando Lote", i, "de", num_lotes, "(Respuestas", inicio, "-", fin, ")\n")
# Extraer el texto del lote actual
texto_lote <- paste(respuestas_completas[inicio:fin], collapse = "\n* ")
# Prompt de Nivel Experto
pregunta_prompt <- paste(
"Instrucción: Actúa como un Investigador Senior experto en Análisis Cualitativo.",
"Analiza el siguiente segmento de respuestas sobre 'Sociedad de Consumo'.",
"\nRespuestas:\n", texto_lote,
"\nTarea: 1. Identifica el constructo o idea matriz dominante en este grupo.",
"2. Identifica 3 categorías emergentes (conceptos clave).",
"3. Describe el tono emocional (ej: frustración, deseo, rechazo, resignación).",
"Responde de forma concisa pero analítica."
)
# Intento de llamada a la API con control de errores
tryCatch({
analisis_acumulado[[i]] <- gemini(pregunta_prompt)
cat("✅ Lote", i, "analizado correctamente.\n")
}, error = function(e) {
cat("❌ Error en lote", i, ": ", e$message, "\n")
analisis_acumulado[[i]] <- paste("Error en este lote:", e$message)
})
# PAUSA LARGA DE SEGURIDAD
if (i < num_lotes) {
cat("Esperando 70 segundos para evitar bloqueo de cuota (429)...\n")
Sys.sleep(70)
}
}
