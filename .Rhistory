# Función para calcular Omega usando la matriz policórica (ideal para tus datos Likert)
obtener_omega_psych <- function(nombres_items, nombre_factor) {
cat("\n--- Análisis para:", nombre_factor, "---\n")
# Calculamos la matriz policórica para datos ordinales de la encuesta
matriz_poly <- polychoric(datos[, nombres_items])$rho
# omega() realiza el análisis factorial y entrega omega_h y omega_t
res <- omega(matriz_poly, nfactors = 1, plot = FALSE)
return(res$omega.tot) # Retornamos el Omega Total
}
# Ejecución factor por factor
