paran(analisis_factorial, iterations = 1000)
efa_modulo <- fa(mitad_arriba, nfactors = 15, rotate = "varimax", fm = "pa")
efa_modulo <- fa(mitad_arriba, nfactors = 4, rotate = "promax", fm = "pa")
