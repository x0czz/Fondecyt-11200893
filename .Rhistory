# NUMERO DE CLUSTERS
# 1. Calcular el costo para diferentes valores de k (ej. de 2 a 10)
costos <- sapply(2:10, function(k){
modelo <- kproto(set_scaled2, k = k, nstart = 5)
return(modelo$tot.withinss) # El costo total
})
# 2️⃣ Crear copia estandarizada SOLO para clustering
set_scaled2 <- set_original2
# 1️⃣ Selección y tipificación correcta de variables
set_original2 <- ESOCC %>%
select(
Consumo_Critico,
Eficiencia_Hogar,
Planificacion,
Facilidad_reciclaje,
Percep_responsabilidad,
situacion_financiera.x,
M15,
M9,
`M13#1`,
`M13#3`,
`M13#7`
) %>%
mutate(
# Variables Numéricas
across(c(Consumo_Critico, Eficiencia_Hogar, Planificacion,
Facilidad_reciclaje, Percep_responsabilidad), as.numeric),
# Variables Categóricas (asegurando coincidencia de nombres)
across(c(situacion_financiera.x, M15, `M13#1`, `M13#3`, `M13#7`), as.factor)
)
# 2️⃣ Crear copia estandarizada SOLO para clustering
set_scaled2 <- set_original2
# Escalamos las primeras 5 columnas (numéricas)
set_scaled2[, 1:5] <- scale(set_scaled2[, 1:5])
# 3️⃣ Fijar semilla para reproducibilidad
set.seed(123)
# NUMERO DE CLUSTERS
# 1. Calcular el costo para diferentes valores de k (ej. de 2 a 10)
costos <- sapply(2:10, function(k){
modelo <- kproto(set_scaled2, k = k, nstart = 5)
return(modelo$tot.withinss) # El costo total
})
# 2. Graficar
plot(2:10, costos, type = "b", pch = 19, frame = FALSE,
xlab = "Número de Clusters (k)",
ylab = "Costo Total (Disimilitud)",
main = "Método del Codo para K-Prototypes")
print("--- Distribuciones Categóricas por Cluster ---")
for(var in vars_categoricas) {
cat("\nVariable:", var, "\n")
print(prop.table(table(set_original2$cluster, set_original2[[var]]), 1))
}
# 4️⃣ Estimar modelo K-prototypes
# Mantenemos k = 4 según tu ejemplo anterior
modelo2 <- kproto(set_scaled2, k = 6, lambda = NULL)
# 5️⃣ Asignar clusters a base ORIGINAL (para interpretación real)
set_original2$cluster <- modelo2$cluster
# 6️⃣ Medias en ESCALA ORIGINAL (Variables Numéricas)
medias_cluster2 <- aggregate(
cbind(Consumo_Critico, Eficiencia_Hogar, Planificacion,
Facilidad_reciclaje, Percep_responsabilidad, M9) ~ cluster,
data = set_original2,
mean
)
print("--- Medias por Cluster (Numéricas) ---")
print(medias_cluster2)
# 7️⃣ Distribución porcentual de variables categóricas
# He automatizado esto en un bucle para las nuevas variables
vars_categoricas <- c("situacion_financiera.x", "M15", "M9", "M13#1", "M13#3", "M13#7")
print("--- Distribuciones Categóricas por Cluster ---")
for(var in vars_categoricas) {
cat("\nVariable:", var, "\n")
print(prop.table(table(set_original2$cluster, set_original2[[var]]), 1))
}
# 8️⃣ Tamaño y Centros
cat("\nTamaño de los clusters:\n")
print(modelo2$size)
cat("\nCentros del modelo (Escalados):\n")
print(modelo2$centers)
modelo2$tot.withinss
modelo2$withinss
modelo2$lambda
table(ESOCC$M9)
cor(ESOCC$M9, ESOCC$Consumo_Critico)
