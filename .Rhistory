library(gridExtra)
library(dplyr)
library(haven)
library(sjPlot)
library(sjlabelled)
library(ggplot2)
Encuesta_Sociedad_de_Consumo_2023 <- read_sav("Encuesta Sociedad de Consumo 2023.sav")
load("~/GitHub/Fondecyt-11200893/ESOCC_FSCORES.RData")
#HIPOTESIS A PROBAR SEGUN BIBLIOGRAFIA
# A mayor educacion, Mayor consumo critico.
h1a <- cor.test(ESOCC$M4, ESOCC$FS_Consumo_Critico)
cor1a <- h1a$estimate
p1a <- h1a$p.value
cor.test(ESOCC$M4, ESOCC$MR2)
#A mayor clase social, mayor consumo critico.
h1b <- ESOCC %>%
mutate(NSE_inv = 8 - as.numeric(NSE)) %>% # Creamos la versión inversa
{ cor.test(.$NSE_inv, .$FS_Consumo_Critico) }
cor1b <- h1b$estimate
p1b <- h1b$p.value
#A Mayor edad mayor consumo critico.
h1c <- cor.test(ESOCC$EDAD, ESOCC$FS_Consumo_Critico)
cor1c <- h1c$estimate
p1c <- h1c$p.value
#Las mujeres participan mas del buycott
h1da <- t.test(as.numeric(O3_4)~ SEXO, Encuesta_Sociedad_de_Consumo_2023)
h1dadif <- h1da$estimate
p1da <- h1da$p.value
h1db <- t.test(as.numeric(O3_1)~ SEXO, Encuesta_Sociedad_de_Consumo_2023)
h1bddif <- h1db$estimate
p1db <- h1db$p.value
h1d1_grafico <- ggplot(Encuesta_Sociedad_de_Consumo_2023,
aes(x = SEXO, y = as.numeric(O3_4))) +
stat_summary(fun = mean, geom = "point", size = 3) +
stat_summary(fun.data = mean_cl_normal,
geom = "errorbar", width = 0.2) +
labs(x = "",
y = "Media",
title = "Buycot") +
theme_minimal()
#A mayor edad, mayor consumo critico
h1e <- cor.test(ESOCC$EDAD, ESOCC$FS_Consumo_Critico)
cor1e <- h1e$estimate
p1e <- h1e$p.value
h1d1_grafico2 <- ggplot(Encuesta_Sociedad_de_Consumo_2023,
aes(x = SEXO, y = as.numeric(O3_1))) +
stat_summary(fun = mean, geom = "point", size = 3) +
stat_summary(fun.data = mean_cl_normal,
geom = "errorbar", width = 0.2) +
labs(x = "",
y = "",
title = "Boicot") +
theme_minimal()
#Estudiantes y trabajadores domesticos mas propensos a consumir criticamente
ESOCC$O3_1 <- factor(ESOCC$O3_1, levels = sort(unique(ESOCC$O3_4)),ordered = TRUE)
#Gente que nunca ha trabajado, participan menos en el consumo critico
# La bibliografia indica que, los diferentes recursos pueden incidir mas en el buycot que en el boycot;
# los recursos por lo tanto predicen mejor el buycot que el boycot
subsetreg <- ESOCC %>%
select(FS_Consumo_Critico, SEXO, NSE, EDAD, M4) %>%
mutate(
NSE_inv = 8 - as.numeric(NSE),
SEXO = as_factor(SEXO),
M4 = set_label(M4, label = "Educación")
)
reg1 <- lm(FS_Consumo_Critico~ EDAD + NSE_inv+ M4, subsetreg)
tabreg1 <- tab_model(
reg1,
show.std = "std",
show.est = TRUE,
show.ci = FALSE,
p.style = "numeric",
dv.labels = "Consumo critico",
string.std = "std(b)"
)
