mutate(Porcentaje = round(n / sum(n) * 100, 1))
library(tidyverse)
# Función rápida para ver distribución de categóricas
resumen_cat <- datos_perfil %>%
select(cluster_id, where(is.factor)) %>%
pivot_longer(-cluster_id, names_to = "Variable", values_to = "Categoria") %>%
group_by(cluster_id, Variable, Categoria) %>%
summarise(n = n(), .groups = 'drop') %>%
group_by(cluster_id, Variable) %>%
mutate(Porcentaje = round(n / sum(n) * 100, 1))
print("--- Distribución de Variables Categóricas (%) ---")
print(resumen_cat)
